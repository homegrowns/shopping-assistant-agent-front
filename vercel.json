{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/search",
      "destination": "http://shopping-ai-agent-stg-alb-1320694677.ap-northeast-2.elb.amazonaws.com/search"
    },
    {
      "source": "/search/:path*",
      "destination": "http://shopping-ai-agent-stg-alb-1320694677.ap-northeast-2.elb.amazonaws.com/search/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}